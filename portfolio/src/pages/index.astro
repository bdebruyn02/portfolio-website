---
import '../styles/global.css';
import Profile from "../components/Profile.astro";
import Skills from "../components/Skills.astro";
import WorkHistory from "../components/WorkHistory.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Contact from "../components/Contact.astro";
---

<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Brandon de Bruyn | Full-Stack Engineer</title>
  </head>
  <body class="min-h-screen bg-[#0a0a0a] text-[#e5e2e1] antialiased">
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="grid-pattern absolute inset-0"></div>
    </div>

    <nav class="fixed top-0 z-50 w-full border-b border-white/10 bg-[#131313]/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-6">
        <a href="#profile" class="font-geist text-xs font-bold uppercase text-white">
          bdebruyn.dev
        </a>
        <div class="hidden items-center gap-8 md:flex">
          <a class="nav-link" href="#profile">About</a>
          <a class="nav-link" href="#skills">Stack</a>
          <a class="nav-link" href="#projects">Projects</a>
          <a class="nav-link" href="#history">Experience</a>
          <a class="nav-link" href="#contact">Contact</a>
        </div>
        <a
          href="https://bdebruyn02.github.io/cdn/docs/brandon_de_bruyn_resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded border border-white bg-white px-4 py-2 font-geist text-xs font-semibold uppercase text-[#131313] transition hover:bg-transparent hover:text-white"
        >
          Resume
        </a>
      </div>
    </nav>

    <main class="mx-auto flex max-w-6xl flex-col gap-28 px-5 pb-20 pt-28 md:px-6 md:pt-32">
      <Profile />
      <Skills />
      <FeaturedProjects />
      <WorkHistory />
      <Contact />
    </main>

    <footer class="border-t border-white/10 bg-[#131313] py-8">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 text-sm text-[#c4c7c8] md:flex-row md:px-6">
        <div class="font-geist text-xs font-semibold uppercase text-white">bdebruyn.dev</div>
      </div>
    </footer>
  </body>
</html>
