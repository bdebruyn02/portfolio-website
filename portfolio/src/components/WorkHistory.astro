---
// Work History section
interface Job {
  company: string;
  period: string;
  title: string;
  description?: string;
}

const jobs : Job[] = [
  {
    company: "CBOS",
    period: "2024 - Present",
    title: "Intermediate Software Developer",
    description:
      "<p>At CBOS, I develop and maintain web applications that support both internal operations and IoT solutions. My role involves full-stack development, working across front-end, back-end, and databases to deliver practical, reliable software.</p><p>Key Responsibilities:<br>• Develop and maintain full-stack web applications using ASP.NET Core, Angular, SQL Server, and PostgreSQL<br>• Design and implement backend APIs, business logic, and frontend features for internal and customer-facing systems<br>• Collaborate with cross-functional teams in agile development environments<br>• Contribute to performance optimization, debugging, testing, and deployment workflows<br>• Participate in architectural discussions and technical problem solving across multiple projects<br>• Work with modern development practices including Git workflows, CI/CD processes, and production support</p>",
  },
  {
    company: "Microzone Solutions",
    period: "2022 - 2024",
    title: "Software Developer",
    description: "<p>At Microzone, I maintained and developed software solutions by creating Micro-Front Ends in Angular and Micro API Services in ASP.NET C#. Key highlights include:</p><p>• Developed and optimized database changes using Microsoft SQL.<br>• Collaborated with senior developers on project management and strategic initiatives.<br>• Delivered projects in TypeScript, SQL, and C# as part of a small team, consistently exceeding deadlines through teamwork.</p>"
  },
  {
    company: "Project (OriginX)",
    period: "2022 - 2024",
    title: "Lead Developer",
    description: "<p>In the Origin X Project, I contributed effectively both independently and as part of a team.&nbsp;<br>Key accomplishments include:</p><p>• Set up and configured a TeamSpeak server on Debian Linux via SSH.<br>• Configured a Rack Server to ensure global connectivity for end-users.<br>• Independently optimized the server to handle high workflow demands smoothly.</p>"
  },
];
---

<section id="history" class="scroll-mt-28">
  <div class="mb-8">
    <p class="section-kicker">Experience</p>
    <h2 class="section-title">A practical path through product and platform work.</h2>
  </div>
  <div class="ml-3 flex flex-col gap-12 border-l border-white/10 py-2 pl-8">
    {
      jobs.map((job) => (
        <article class="relative">
          <div class="absolute -left-[37px] top-2 h-3 w-3 rounded-full border-2 border-[#0a0a0a] bg-indigo-400 ring-1 ring-indigo-400/60"></div>
          <div class="mb-2 flex flex-col justify-between gap-2 md:flex-row md:items-baseline">
            <h3 class="text-xl font-medium text-white">{job.title}</h3>
            <span class="font-geist text-xs text-[#8e9192]">{job.period}</span>
          </div>
          <div class="mb-4 font-geist text-xs font-semibold uppercase text-indigo-300">{job.company}</div>
          {job.description && (
            <div class="timeline-copy max-w-4xl text-sm leading-7 text-[#c4c7c8]" set:html={job.description}></div>
          )}
        </article>
      ))
    }
  </div>
</section>
