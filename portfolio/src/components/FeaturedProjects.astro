---
// Featured Projects section
interface Project {
  name: string;
  desc: string;
  img: string;
  url: string;
  tags: string[];
}

const imageBase = "https://bdebruyn02.github.io/cdn/images/";
const projects: Project[] = [
  {
    name: "MatchDeck",
    desc: "A minimalistic, professional desktop application for managing sports scoreboards and advertisement/video playback. Built for sports venues, clubs, schools, and small broadcast setups. The operator control panel is fast and functional, while the public-facing scoreboard delivers large, high-contrast visuals optimized for viewing from a distance.",
    img: imageBase + "in_progress_placeholder.png",
    url: "#projects",
    tags: ["Desktop", "Scoreboards", "Playback"],
  },
  {
    name: "Queue",
    desc: "An Angular and Tauri Raspberry Pi ad scheduling and playback program designed to manage queued media playback on lightweight venue hardware.",
    img: imageBase + "in_progress_placeholder.png",
    url: "#projects",
    tags: ["Angular", "Tauri", "Raspberry Pi"],
  },
  {
    name: "FundMan - Fund Management System",
    desc: "FundMan is a modern, user-friendly web app for managing personal finances. Users can log expenses, apply savings rules, and visualize spending trends to set and achieve savings goals. Future updates will add reports, data import/export, and more.",
    img: imageBase + "fund_man.png",
    url: "https://fundman-a6785.web.app/",
    tags: ["Finance", "Web App", "SaaS"],
  },
  {
    name: "Coronia Hotel Website",
    desc: "Redesigned and rebuilt the Coronia Hotel website for a hotel in Lagos, Nigeria. The new site features a modern look, improved contact options, and is ready for future upgrades.",
    img: imageBase + "coronia-hotel.png",
    url: "https://coroniahotel.com/",
    tags: ["Website", "Hospitality", "Client Work"],
  },
];
---

<section id="projects" class="scroll-mt-28">
  <div class="mb-8">
    <p class="section-kicker">Featured Projects</p>
    <h2 class="section-title">Selected builds with real-world constraints.</h2>
  </div>
  <div class="grid gap-5 md:grid-cols-2">
    {
      projects.map((project) => (
        <article class="glass-panel group flex h-full flex-col overflow-hidden rounded-lg">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative block h-44 overflow-hidden border-b border-white/10 bg-[#111111]"
          >
            <img
              src={project.img}
              alt={project.name}
              class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
          </a>

          <div class="flex flex-1 flex-col p-5">
            <div class="mb-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="chip rounded px-2 py-1 font-geist text-[10px] uppercase text-white">{tag}</span>
              ))}
            </div>
            <h3 class="text-xl font-medium text-white">{project.name}</h3>
            <p class="mt-3 text-sm leading-6 text-[#c4c7c8]">{project.desc}</p>
            <a
              href={project.url}
              class="mt-5 inline-flex w-fit items-center rounded border border-white/10 px-3 py-2 font-geist text-xs font-semibold uppercase text-white transition hover:border-indigo-400 hover:text-indigo-300"
              target="_blank"
              rel="noopener noreferrer"
            >
              View Project
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
